<div id="Cubo" class="fixed top-0 bottom-0 h-full w-full -z-1">

</div>

<script>
	import * as THREE from 'three';
	import { FBXLoader } from 'three/examples/jsm/loaders/FBXLoader.js';


	// =====================================================
	// ELEMENTOS HTML
	// =====================================================

	const container = document.querySelector<HTMLElement>('.relod');
	const $Cubo = document.getElementById('Cubo');

	const nextButton = document.getElementById('nextSection');
	const prevButton = document.getElementById('prevSection');


	// =====================================================
	// VARIABLES
	// =====================================================

	let w = window.innerWidth;
	let h = window.innerHeight;

	let currentIndex = 0;

	// Velocidad de rotación
	let rotationSpeed = 0.005;


	// =====================================================
	// ESCENA
	// =====================================================

	const scene = new THREE.Scene();


	// =====================================================
	// CÁMARA
	// =====================================================

	const camera = new THREE.PerspectiveCamera(
		75,
		w / h,
		0.1,
		2000
	);

	camera.position.set(
		0,
		0,
		100
	);

	scene.add(camera);


	// =====================================================
	// RENDERER
	// =====================================================

	const renderer = new THREE.WebGLRenderer({
		antialias: true,
		alpha: true
	});

	renderer.setSize(w, h);

	renderer.setPixelRatio(
		Math.min(window.devicePixelRatio, 2)
	);

	renderer.setClearColor(
		0x000000,
		0
	);


	if ($Cubo) {

		$Cubo.appendChild(
			renderer.domElement
		);

	}


	// =====================================================
	// OBJETO PRINCIPAL
	// =====================================================

	// IMPORTANTE:
	// Ahora manejamos TODO el FBX como un solo objeto.

	let model: THREE.Group | null = null;


	// =====================================================
	// TEXTURA
	// =====================================================

	const textureLoader =
		new THREE.TextureLoader();

	const texture =
		textureLoader.load(
			'/OBJ/Islands.png',

			function () {

				console.log(
					'Textura cargada correctamente'
				);

			},

			undefined,

			function (error) {

				console.error(
					'Error cargando textura:',
					error
				);

			}
		);


	// =====================================================
	// FBX LOADER
	// =====================================================

	const fbxLoader =
		new FBXLoader();


	// =====================================================
	// CARGAR FBX
	// =====================================================

	fbxLoader.load(

		'/OBJ/Islands.fbx',

		function (object) {

			console.log(
				'FBX cargado:',
				object
			);


			// =============================================
			// RECORRER MODELO
			// =============================================

			object.traverse(
				function (child) {

					if (
						child instanceof THREE.Mesh
					) {

						// -----------------------------
						// TEXTURA
						// -----------------------------

						if (
							child.material
						) {

							if (
								Array.isArray(
									child.material
								)
							) {

								child.material.forEach(
									function (material) {

										material.map =
											texture;

										material.needsUpdate =
											true;

									}
								);

							}

							else {

								child.material.map =
									texture;

								child.material.needsUpdate =
									true;

							}

						}

						// -----------------------------
						// SOMBRAS
						// -----------------------------

						child.castShadow = true;

						child.receiveShadow = true;

					}

				}
			);


			// =============================================
			// CENTRAR EL MODELO COMPLETO
			// =============================================

			const box =
				new THREE.Box3().setFromObject(
					object
				);

			const center =
				box.getCenter(
					new THREE.Vector3()
				);


			object.position.x -=
				center.x;

			object.position.y -=
				center.y;

			object.position.z -=
				center.z;


			// =============================================
			// POSICIÓN DEL MODELO
			// =============================================

			object.position.z =
				-500;


			// =============================================
			// GUARDAR MODELO
			// =============================================

			model =
				object;


			// =============================================
			// AGREGAR A ESCENA
			// =============================================

			scene.add(
				model
			);


			console.log(
				'Modelo agregado a la escena'
			);

			console.log(
				'Posición:',
				model.position
			);

			console.log(
				'Escala:',
				model.scale
			);

		},


		// =============================================
		// PROGRESO
		// =============================================

		function (xhr) {

			if (xhr.total) {

				console.log(
					'Carga FBX:',
					(
						xhr.loaded /
						xhr.total *
						100
					).toFixed(0) + '%'
				);

			}

		},


		// =============================================
		// ERROR
		// =============================================

		function (error) {

			console.error(
				'ERROR cargando Islands.fbx:',
				error
			);

		}

	);


	// =====================================================
	// LUCES
	// =====================================================

	const ambientLight =
		new THREE.AmbientLight(
			0xffffff,
			1.5
		);

	scene.add(
		ambientLight
	);


	const directionalLight =
		new THREE.DirectionalLight(
			0xffffff,
			3
		);

	directionalLight.position.set(
		140,
		55,
		15
	);

	scene.add(
		directionalLight
	);


	// =====================================================
	// ESTADOS DE LAS SECCIONES
	// =====================================================

	type SectionState = {
		x: number;
		y: number;
		z: number;
		rotationY: number;
		autoRotate: boolean;
	};

	const sectionStates: Record<number, SectionState> = {

		0: {
			x: 0,
			y: 0,
			z: -500,
			rotationY: 0,
			autoRotate: true
		},

		1: {
			x: 0,
			y: -70,
			z: -500,
			rotationY: Math.PI * 0.8,
			autoRotate: false
		},

		2: {
			x: -200,
			y: 0,
			z: -500,
			rotationY: Math.PI / 2.9,
			autoRotate: false
		},

		3: {
			x: 350,
			y: 0,
			z: -500,
			rotationY: Math.PI * 1.3,
			autoRotate: false
		},

		4: {
			x: 0,
			y: -70,
			z: -500,
			rotationY: Math.PI * 5,
			autoRotate: false
		},

		5: {
			x: 0,
			y: -400,
			z: -500,
			rotationY: Math.PI * 1.8,
			autoRotate: false
		},

		6: {
			x: 0,
			y: -1200,
			z: -500,
			rotationY: Math.PI / 2,
			autoRotate: false
		}

	};


	// =====================================================
	// ANIMACIÓN HACIA UNA POSICIÓN
	// =====================================================

	let animationId: number | null = null;


	function animateToState(state: SectionState) {

		if (!model) {

			console.warn(
				'El modelo todavía no ha cargado'
			);

			return;

		}

		const currentModel = model;


		// =============================================
		// CANCELAR ANIMACIÓN ANTERIOR
		// =============================================

		if (animationId !== null) {

			cancelAnimationFrame(
				animationId
			);

		}


		// =============================================
		// VALORES INICIALES
		// =============================================

		const startX =
			currentModel.position.x;

		const startY =
			currentModel.position.y;

		const startZ =
			currentModel.position.z;


		const startRotationY =
			currentModel.rotation.y;


		// =============================================
		// DIFERENCIA DE ROTACIÓN
		// =============================================

		let deltaRotation =
			state.rotationY -
			startRotationY;


		// Normalizar entre -PI y PI

		deltaRotation =
			(
				(
					deltaRotation +
					Math.PI
				) %
				(
					Math.PI * 2
				)
			) -
			Math.PI;


		// =============================================
		// TIEMPO
		// =============================================

		const duration = 1000;

		const startTime =
			performance.now();


		// =============================================
		// ANIMAR
		// =============================================

		function update(time: number) {

			const elapsed =
				time -
				startTime;


			const progress =
				Math.min(
					elapsed / duration,
					1
				);


			// Easing
			const ease =
				progress *
				progress *
				(
					3 -
					2 *
					progress
				);


			// =========================================
			// POSICIÓN
			// =========================================

			currentModel.position.x =
				startX +
				(
					state.x -
					startX
				) *
				ease;


			currentModel.position.y =
				startY +
				(
					state.y -
					startY
				) *
				ease;


			currentModel.position.z =
				startZ +
				(
					state.z -
					startZ
				) *
				ease;


			// =========================================
			// ROTACIÓN
			// =========================================

			currentModel.rotation.y =
				startRotationY +
				deltaRotation *
				ease;


			// =========================================
			// CONTINUAR
			// =========================================

			if (progress < 1) {

				animationId =
					requestAnimationFrame(
						update
					);

			}

			else {

				// =====================================
				// ASEGURAR VALORES EXACTOS
				// =====================================

				currentModel.position.set(
					state.x,
					state.y,
					state.z
				);


				currentModel.rotation.y =
					state.rotationY;


				animationId =
					null;

			}

		}


		animationId =
			requestAnimationFrame(
				update
			);

	}


	// =====================================================
	// ANIMACIÓN PRINCIPAL
	// =====================================================

	function animate() {

		requestAnimationFrame(
			animate
		);


		// =============================================
		// ROTACIÓN AUTOMÁTICA
		// =============================================

		if (model && rotationSpeed !== 0) {

			model.rotation.y += rotationSpeed;

		}


		// =============================================
		// RENDER
		// =============================================

		renderer.render(
			scene,
			camera
		);

	}


	animate();


	// =====================================================
	// SCROLL TO SECTION
	// =====================================================

	function scrollToSection(index: number) {

		const sections =
			document.querySelectorAll(
				'.section'
			);


		// =============================================
		// VALIDAR INDEX
		// =============================================

		if (
			index < 0 ||
			index >= sections.length
		) {

			return;

		}


		const state =
			sectionStates[index];


		if (!state) {

			console.warn(
				'No existe configuración para index:',
				index
			);

			return;

		}


		// =============================================
		// ACTUALIZAR INDEX
		// =============================================

		currentIndex =
			index;


		// =============================================
		// MOVER CONTENEDOR
		// =============================================

		if (container) {

			container.style.transition =
				'transform 1s ease';


			container.style.transform =
				`translateY(-${currentIndex * h}px)`;

		}


		// =============================================
		// ROTACIÓN AUTOMÁTICA
		// =============================================

		if (state.autoRotate) {

			rotationSpeed =
				0.005;

		}

		else {

			rotationSpeed =
				0;

		}


		// =============================================
		// ANIMAR MODELO
		// =============================================

		animateToState(
			state
		);

	}


	// =====================================================
	// NEXT
	// =====================================================

	nextButton?.addEventListener(
		'click',
		function () {

			scrollToSection(
				currentIndex + 1
			);

		}
	);


	// =====================================================
	// PREVIOUS
	// =====================================================

	prevButton?.addEventListener(
		'click',
		function () {

			scrollToSection(
				currentIndex - 1
			);

		}
	);


	// =====================================================
	// RUEDA DEL MOUSE
	// =====================================================

	

	// =====================================================
	// TECLADO
	// =====================================================

	window.addEventListener(
		'keydown',
		function (event) {

			if (
				event.key ===
				'ArrowDown'
			) {

				scrollToSection(
					currentIndex + 1
				);

			}

			else if (
				event.key ===
				'ArrowUp'
			) {

				scrollToSection(
					currentIndex - 1
				);

			}

		}
	);


	// =====================================================
	// RESIZE
	// =====================================================

	window.addEventListener(
		'resize',
		function () {

			h =
				window.innerHeight;

			w =
				window.innerWidth;


			camera.aspect =
				w / h;


			camera.updateProjectionMatrix();


			renderer.setSize(
				w,
				h
			);


			// Mantener posición
			// de la sección actual

			if (model) {

				const state =
					sectionStates[
						currentIndex
					];

				if (state) {

					model.position.set(
						state.x,
						state.y,
						state.z
					);

				}

			}

		}
	);

	const sectionMap = {
		'#hero': 0,
		'#aboutme': 1,
		'#skills': 2,
		'#tecnologies': 3,
		'#proyects': 4,
		'#connect': 5
	};

	const menuLinks =
		document.querySelectorAll(
			'a[href^="#"]'
		);

	menuLinks.forEach(function (link) {

		link.addEventListener(
			'click',
			function (event) {

				const href =
					link.getAttribute('href');

			if (!href || !(href in sectionMap)) {
					return;
				}

				event.preventDefault();

				scrollToSection(
				sectionMap[href as keyof typeof sectionMap]
				);

			}
		);

	});

</script>
