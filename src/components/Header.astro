---
import Logo from '../components/Logo.astro';

const headerClasses = 'px-4 py-2 -skew-y-2 bg-[var(--color-secondary)] md:bg-transparent flex flex-grow hover:bg-transparent';
const headerAClasses = 'px-1 py-1 md:bg-transparent flex flex-grow hover:underline hover:bg-[var(--color-primary)] md:hover:text-[var(--color-accent)] hover:scale-105';
---

<header class="flex items-center justify-between w-full fixed top-0 z-40 bg-[var(--color-accent)] md:bg-transparent text-[var(--color-textTitle)] md:text-[var(--color-accent)] bg-opacity-5 shadow-md md:text-sm 2xl:text-xl px-5">
    <!-- Logo -->
    <div class="items-center">
        <a href="/">
            <Logo>
        </a>
    </div>

    
    {Astro.url.pathname === '/' ? (
        <>
        <!-- Botón hamburguesa -->
        <button type="button" class="lg:hidden p-2 rounded hover:text-[var(--color-primary)]" onclick="window.openMenu()" aria-label="Abrir menú">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </button>

        <!-- Menú -->
        <nav id="main-menu" class="hidden absolute top-full left-0 w-full bg-[var(--color-accent)] md:bg-transparent text-[var(--color-accent)] md:text-[var(--color-text)] z-50 flex-col lg:flex lg:flex-row lg:static lg:w-auto lg:items-center lg:gap-6">
            <ul class="flex flex-col lg:flex-row w-full lg:w-auto p-2 md:p-0 space-y-2 md:space-y-0">
                <li class={headerClasses}><a class={headerAClasses} href="#hero">Home</a></li>
                <li class={headerClasses}><a class={headerAClasses} href="#aboutme">About Me</a></li>
                <li class={headerClasses}><a class={headerAClasses} href="#skills">Skills</a></li>
                <li class={headerClasses}><a class={headerAClasses} href="#tecnologies">Technologies</a></li>
                <li class={headerClasses}><a class={headerAClasses} href="#proyects">Projects</a></li>
            </ul>

            <ul class="flex flex-col lg:flex-row w-full text-[var(--color-text)] md:text-[var(--color-accent)] lg:w-auto p-2 md:p-0">
                <li class="lg:ml-auto"><a class="px-4 py-2 -skew-y-2 flex flex-grow hover:underline hover:bg-[var(--color-primary)] md:bg-[var(--color-secondary)] hover:text-[var(--color-accent)] hover:scale-105 " href="#connect">Connect</a></li>
            </ul>
        </nav>
       </>
    ) : (
        <>
            <button type="button" class="flex flex-row w-44 items-center justify-center p-1 bg-[var(--color-secondary)] hover:underline text-[var(--color-accent)] hover:bg-[var(--color-primary)]" onclick="window.history.back()" aria-label="Regresar a la página anterior">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 18l-6-6 6-6"/>
                </svg>
                <a class="text-base">Back</a>
            </button>
            
        </>
    )}

    
</header>

<script>
    declare global {
        interface Window {
            openMenu: () => void;
        }
    }

    function openMenu() {
        const menu = document.getElementById('main-menu');
        if (!menu) return;

        const isVisible = !menu.classList.contains('hidden');

        if (isVisible) {
            closeMenu();
        } else {
            menu.classList.remove('hidden');
            menu.classList.add('flex');
            setTimeout(() => {
                document.addEventListener('click', closeMenuOnOutsideClick);
            }, 0); // Evita que se cierre inmediatamente por el mismo click del botón
        }
    }

    function closeMenu() {
        const menu = document.getElementById('main-menu');
        if (!menu) return;

        menu.classList.add('hidden');
        menu.classList.remove('flex');
        document.removeEventListener('click', closeMenuOnOutsideClick);
    }

    function closeMenuOnOutsideClick(e: MouseEvent) {
        const menu = document.getElementById('main-menu');
        const button = (e.target as HTMLElement)?.closest('button[aria-label="Abrir menú"]');
        if (menu && !menu.contains(e.target as Node) && !button) {
            closeMenu();
        }
    }

    document.querySelectorAll('#main-menu a').forEach((link) => {
        link.addEventListener('click', closeMenu);
    });

    window.openMenu = openMenu;
</script>