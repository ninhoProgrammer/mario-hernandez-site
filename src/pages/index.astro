---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/button.astro';
---

<Layout title="Portfolio of Mario Hernández - Software & Web Developer">
	<main class="relod">
		<section id="hero" class="section flex h-[100dvh] w-screen flex-col md:relative items-center justify-center">
			<Hero />
		</section>

		<section id="aboutme" class="section md:pr-[360px] h-[100dvh] w-screen flex justify-center items-center">
			<Card title="About me" text="Software developer specialized in C#, Windows Forms, and .NET and passionate about the Astro framework with plugins using React.js or Vue.js that I have used in some of my projects" img="../playa.webp" href="/aboutme" />
		</section>
		
		<section id="skills" class="section md:pl-[740px] h-[100dvh] w-screen flex justify-center md:justify-end items-center">
			<Card title="Skills" text="As a developer, from writing clean C# code for desktop apps to working with modern tools like Astro, I'm always learning and improving." img="../bosque.webp" href="/skills" />
		</section>
		
		<section id="tecnologies" class="section md:pr-[740px] h-[100dvh] w-screen flex justify-center md:justify-start items-center">
			<Card title="Tecnologies" text="This is a list of the technologies I have used in my projects, from C# and .NET to Astro.js and Three.js, including Vue.js and React.js. " img="../montain.webp" href="/tecnologies" />
		</section>

		<section id="myproyects"  class="section md:pl-[360px] h-[100dvh] w-screen flex justify-center md:justify-end items-center ">
			<Card title="My Projects" text="Here are some of the projects I've worked on, showcasing my skills and experience in software development." img="../desiert.webp" href="/proyects" />
		</section>
		
		<section id="connect" class="section mt-0 h-[100dvh] w-screen flex justify-center items-center">
			<Card title="Connect" text="If you want to connect, feel free to reach out through the contact form or follow me on social media." img="../blue-sky-background.webp" href="/connect" />	
		</section>

	</main>
	<Button />
</Layout>

<style>
.section {
	transition: transform 10s ease-in-out;
}
</style>

