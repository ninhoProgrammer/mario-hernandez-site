---
import Header from '../components/Header.astro';

import '../styles/global.css';
const { title } = Astro.props;
const bodyClasses = `bg-[url('/blue-sky-background.webp')] bg-fixed bg-cover bg-[var(--color-secondary)]`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Discover the portfolio of Mario Hernández Martínez, Software Developer with experience in creating robust and scalable applications using modern and cutting-edge tools, and secure web software deployment." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="../MakeWeb_MM.svg"/>
		<title>{title}</title>
	</head>
	<body class={bodyClasses}>
		<Header />
		<slot />
	</body>
</html>
